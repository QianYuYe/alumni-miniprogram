.alumni-card {
  display: flex;
  background: white;
  padding: 28rpx;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  position: relative;
  transition: transform 0.3s ease;
}

.alumni-card:active {
  transform: scale(0.98);
}

.alumni-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 3rpx solid #f0f2f5;
}

.alumni-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.alumni-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.alumni-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.verified-badge {
  width: 24rpx;
  height: 24rpx;
  margin-left: 6rpx;
}

.alumni-year {
  font-size: 22rpx;
  color: #aaa;
  margin-left: 12rpx;
  background: #f5f6fa;
  padding: 2rpx 14rpx;
  border-radius: 10rpx;
}

.alumni-dept {
  font-size: 24rpx;
  color: #888;
  display: block;
  margin-bottom: 4rpx;
}

.alumni-location {
  font-size: 22rpx;
  color: #bbb;
  display: block;
  margin-bottom: 8rpx;
}

.alumni-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.alumni-action {
  display: flex;
  align-items: center;
  margin-left: 12rpx;
}

.contact-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border: none;
  border-radius: 24rpx;
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.25);
  transition: all 0.3s ease;
}

.contact-btn:active {
  opacity: 0.8;
  transform: scale(0.95);
}
