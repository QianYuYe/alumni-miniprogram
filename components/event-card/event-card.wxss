.event-card {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.event-cover {
  width: 100%;
  height: 300rpx;
  background: #f0f0f0;
}

.event-info {
  padding: 24rpx;
}

.event-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.event-meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.meta-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #888;
}

.event-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0 12rpx;
}

.event-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.event-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.event-status.upcoming {
  background: #e8f0fe;
  color: #667eea;
}

.event-status.ended {
  background: #f5f5f5;
  color: #999;
}

.event-participants {
  font-size: 22rpx;
  color: #aaa;
}
