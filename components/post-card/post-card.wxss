.post-card {
  background: white;
  margin: 16rpx 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.post-card:active {
  transform: scale(0.99);
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx 28rpx 0;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.user-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 2rpx solid #f0f0f0;
}

.user-meta {
  margin-left: 16rpx;
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.verified-badge {
  width: 28rpx;
  height: 28rpx;
  margin-left: 6rpx;
}

.post-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
  display: block;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  max-width: 40%;
}

.tag-list .tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
}

/* 卡片内容 */
.card-body {
  padding: 20rpx 28rpx;
}

.post-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  word-break: break-word;
}

/* 图片网格 */
.post-images {
  margin-top: 20rpx;
}

.image-grid {
  display: grid;
  gap: 6rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.grid-one {
  grid-template-columns: 1fr;
}

.grid-one .post-image {
  max-height: 400rpx;
  width: 100%;
}

.grid-two {
  grid-template-columns: 1fr 1fr;
}

.grid-two .post-image {
  height: 280rpx;
}

.grid-three {
  grid-template-columns: 1fr 1fr;
}

.grid-three .post-image:first-child {
  grid-column: 1 / -1;
  height: 320rpx;
}

.grid-three .post-image:not(:first-child) {
  height: 200rpx;
}

.grid-four, .grid-more {
  grid-template-columns: 1fr 1fr;
}

.grid-four .post-image, .grid-more .post-image {
  height: 200rpx;
}

.post-image {
  background: #f5f5f5;
  border-radius: 8rpx;
}

/* 位置和标签 */
.post-meta {
  margin-top: 16rpx;
}

.post-location {
  font-size: 24rpx;
  color: #aaa;
  display: block;
  margin-bottom: 8rpx;
}

.post-meta-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.post-views {
  font-size: 22rpx;
  color: #ccc;
  flex-shrink: 0;
}

.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

/* 操作栏 */
.card-actions {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 20rpx 28rpx;
  border-top: 2rpx solid #f5f5f5;
  margin-top: 16rpx;
}

.action-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  flex: 1;
}

.action-item:active {
  opacity: 0.6;
}

.action-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.action-icon {
  font-size: 32rpx;
  line-height: 1;
}

.action-icon-wrap.liked .action-icon {
  animation: like-animation 0.3s ease;
}

@keyframes like-animation {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.action-count {
  font-size: 24rpx;
  color: #bbb;
  line-height: 1;
}

.action-count.liked {
  color: #e74c5e;
}

/* 分享按钮 */
.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1;
  font-size: inherit;
  width: auto;
  height: auto;
}

.share-btn::after {
  border: none;
}
