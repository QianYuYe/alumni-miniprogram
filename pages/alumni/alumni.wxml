<view class="page-container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索校友姓名、公司、职位" value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch" />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="clearSearch">✕</text>
    </view>
    <text class="search-btn" bindtap="onSearch">搜索</text>
  </view>

  <!-- 筛选条件 -->
  <view class="filter-bar">
    <view class="filter-item" bindtap="showDeptFilter">
      <text class="filter-label">{{selectedDept || '全部学院'}}</text>
      <text class="filter-arrow">▼</text>
    </view>
    <view class="filter-item" bindtap="showYearFilter">
      <text class="filter-label">{{selectedYear || '全部年级'}}</text>
      <text class="filter-arrow">▼</text>
    </view>
    <view class="filter-item" bindtap="showTagFilter">
      <text class="filter-label">{{selectedTag || '全部标签'}}</text>
      <text class="filter-arrow">▼</text>
    </view>
  </view>

  <!-- 校友统计 -->
  <view class="alumni-stats">
    <text class="stats-text">共 {{total}} 位校友</text>
  </view>

  <!-- 校友列表 -->
  <view class="alumni-list">
    <block wx:for="{{alumniList}}" wx:key="id">
      <alumni-card alumni="{{item}}" />
    </block>

    <view class="load-more" wx:if="{{hasMore}}">
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
    </view>

    <view class="no-more" wx:if="{{!hasMore && alumniList.length > 0}}">
      <text>— 已经到底了 —</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{alumniList.length === 0 && !isLoading}}">
    <text class="empty-icon">🔍</text>
    <text class="empty-text">未找到匹配的校友</text>
    <text class="empty-subtext">试试其他筛选条件</text>
  </view>
</view>
