.detail-container {
  min-height: 100vh;
  padding-bottom: 120rpx;
  background: #f0f2f5;
}

.detail-cover {
  width: 100%;
  height: 420rpx;
  background: #f0f0f0;
}

.detail-card {
  background: white;
  margin: -40rpx 20rpx 20rpx;
  border-radius: 28rpx;
  padding: 36rpx;
  position: relative;
  box-shadow: 0 -4rpx 30rpx rgba(0, 0, 0, 0.08);
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  margin-bottom: 28rpx;
  line-height: 1.4;
}

/* 信息行 */
.detail-meta {
  margin-bottom: 28rpx;
}

.meta-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #f8f9fc;
  border-radius: 16rpx;
}

.meta-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  line-height: 1.4;
}

.meta-content {
  flex: 1;
}

.meta-label {
  font-size: 22rpx;
  color: #bbb;
  display: block;
  margin-bottom: 4rpx;
}

.meta-value {
  font-size: 28rpx;
  color: #333;
}

/* 详情段落 */
.detail-section {
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  display: block;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 参与者 */
.participants-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.participant-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 96rpx;
}

.participant-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-bottom: 8rpx;
  border: 2rpx solid #f0f0f0;
}

.participant-name {
  font-size: 20rpx;
  color: #999;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

.more-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f5f6fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #eee;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.bottom-actions {
  display: flex;
  align-items: center;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 24rpx;
  font-size: 20rpx;
  color: #bbb;
}

.action-btn.active {
  color: #e74c5e;
}

.join-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 700;
  margin-left: 20rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
  transition: all 0.3s ease;
}

.join-btn:active {
  opacity: 0.9;
  transform: scale(0.97);
}
