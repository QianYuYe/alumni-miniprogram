.login-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 35%, #f0f2f5 35%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 60rpx;
}

.login-header {
  padding: 100rpx 0 60rpx;
  text-align: center;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  filter: drop-shadow(0 4rpx 12rpx rgba(0,0,0,0.1));
}

.app-name {
  font-size: 52rpx;
  font-weight: 800;
  color: white;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.app-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 微信快捷登录 */
.wechat-login {
  width: 88%;
  background: white;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.15);
  margin-bottom: 24rpx;
}

.wechat-login:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.wechat-login-content {
  display: flex;
  align-items: center;
}

.wechat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #e8f0fe;
}

.wechat-login-text {
  display: flex;
  flex-direction: column;
}

.wechat-login-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.wechat-login-desc {
  font-size: 24rpx;
  color: #aaa;
  margin-top: 4rpx;
}

.wechat-arrow {
  font-size: 40rpx;
  color: #ddd;
}

/* 分割文字 */
.divider-text {
  width: 88%;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: #e0e0e0;
}

.divider-label {
  font-size: 24rpx;
  color: #bbb;
  margin: 0 20rpx;
  white-space: nowrap;
}

.login-form {
  width: 88%;
  background: white;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 12rpx 48rpx rgba(102, 126, 234, 0.15);
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-item-half {
  flex: 1;
}

.form-item {
  margin-bottom: 36rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #888;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-hint {
  font-size: 20rpx;
  color: #bbb;
  font-weight: 400;
}

.picker-field {
  background: #f5f6fa;
  border-radius: 16rpx;
  padding: 26rpx 30rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.picker-field:active {
  border-color: #667eea;
}

.picker-field.placeholder {
  color: #bbb;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 24rpx;
  border: none;
  box-shadow: 0 8rpx 28rpx rgba(102, 126, 234, 0.4);
  transition: all 0.3s ease;
}

.login-btn:active {
  transform: scale(0.97);
}

.login-btn[disabled] {
  opacity: 0.4;
  box-shadow: none;
}

.login-tips {
  margin-top: 40rpx;
  text-align: center;
}

.tip-text {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  line-height: 1.8;
}
