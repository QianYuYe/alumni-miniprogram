.publish-container {
  background: white;
  min-height: 100vh;
  padding: 30rpx;
}

.publish-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid #f0f0f0;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-left: 16rpx;
  color: #1a1a2e;
}

/* 内容区域 */
.content-area {
  position: relative;
  margin-bottom: 30rpx;
}

.content-input {
  width: 100%;
  min-height: 280rpx;
  font-size: 30rpx;
  color: #1a1a2e;
  line-height: 1.6;
}

.char-count {
  position: absolute;
  bottom: 0;
  right: 0;
  font-size: 22rpx;
  color: #ddd;
}

/* 图片上传 */
.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 16rpx;
}

.image-section {
  margin-bottom: 30rpx;
}

.image-upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.uploaded-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.uploaded-image image {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.5);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  background: #f5f6fa;
  border-radius: 16rpx;
  border: 2rpx dashed #ddd;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: background 0.3s;
}

.upload-btn:active {
  background: #eee;
}

.upload-icon {
  font-size: 60rpx;
  color: #ddd;
  line-height: 1;
}

.upload-text {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

/* 位置 */
.location-section {
  margin-bottom: 30rpx;
}

.location-input {
  display: flex;
  align-items: center;
  background: #f5f6fa;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  transition: background 0.3s;
}

.location-input:active {
  background: #eee;
}

.location-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.location-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.location-clear {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx;
}

/* 标签 */
.tags-section {
  margin-bottom: 40rpx;
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  padding: 14rpx 30rpx;
  background: #f5f6fa;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #888;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.tag-item:active {
  transform: scale(0.95);
}

.tag-item.active {
  background: linear-gradient(135deg, #e8f0fe, #dce8fb);
  color: #667eea;
  border-color: #667eea;
  font-weight: 500;
}

/* 发布按钮 */
.publish-bottom {
  padding: 20rpx 0 40rpx;
}

.publish-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 8rpx 28rpx rgba(102, 126, 234, 0.35);
  transition: all 0.3s ease;
}

.publish-btn:active {
  transform: scale(0.97);
}

.publish-btn[disabled] {
  opacity: 0.4;
  box-shadow: none;
}
