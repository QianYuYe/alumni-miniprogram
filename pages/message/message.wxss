.page-container {
  min-height: 100vh;
}

/* 消息分类 */
.msg-tabs {
  display: flex;
  background: white;
  padding: 20rpx 20rpx 0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #888;
  border-bottom: 4rpx solid transparent;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: #667eea;
  border-bottom-color: #667eea;
  font-weight: 600;
}

.badge {
  background: #e74c5e;
  color: white;
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 6rpx;
  min-width: 28rpx;
  text-align: center;
  font-weight: 600;
}

/* 消息列表 */
.msg-list {
  padding: 10rpx 0;
}

.msg-item {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 30rpx;
  background: white;
  border-bottom: 2rpx solid #f8f8f8;
  transition: background 0.2s;
}

.msg-item:active {
  background: #f8f6ff;
}

.msg-item.unread {
  background: #f5f3ff;
}

.msg-avatar-wrapper {
  position: relative;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.msg-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.system-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e8f0fe, #dce8fb);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.unread-dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 18rpx;
  height: 18rpx;
  background: #e74c5e;
  border-radius: 50%;
  border: 3rpx solid white;
}

.msg-body {
  flex: 1;
  min-width: 0;
}

.msg-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.msg-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.msg-time {
  font-size: 22rpx;
  color: #ccc;
  flex-shrink: 0;
}

.msg-content {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.empty-subtext {
  font-size: 26rpx;
  color: #ddd;
}
