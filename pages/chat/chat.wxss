.chat-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f0f2f5;
}

.message-list {
  flex: 1;
  padding: 30rpx 20rpx;
  overflow-y: scroll;
}

.message-item {
  display: flex;
  margin-bottom: 24rpx;
}

.message-item.self {
  justify-content: flex-end;
}

.message-item.other {
  justify-content: flex-start;
}

.message-bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  position: relative;
}

.message-item.self .message-bubble {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-bottom-right-radius: 4rpx;
}

.message-item.other .message-bubble {
  background: white;
  color: #333;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
}

.message-time {
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
  display: block;
  margin-top: 8rpx;
  text-align: right;
}

.message-item.other .message-time {
  color: #ccc;
}

.empty-chat {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #ccc;
}

/* 底部输入 */
.chat-input-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  padding-bottom: calc(12rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background: white;
  border-top: 2rpx solid #eee;
  z-index: 100;
}

.tool-btn {
  font-size: 36rpx;
  margin-right: 8rpx;
  padding: 4rpx;
}

.tool-btn:active {
  opacity: 0.6;
}

.chat-input {
  flex: 1;
  height: 64rpx;
  background: #f5f6fa;
  border-radius: 32rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 12rpx;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.send-btn[disabled] {
  opacity: 0.3;
  box-shadow: none;
}

/* 表情面板 */
.emoji-panel {
  position: fixed;
  bottom: 100rpx;
  left: 0;
  right: 0;
  background: #f8f9fc;
  border-top: 2rpx solid #eee;
  padding: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  z-index: 99;
  max-height: 300rpx;
  overflow-y: scroll;
}

.emoji-item {
  font-size: 44rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.emoji-item:active {
  background: #e8e8e8;
  border-radius: 12rpx;
}
