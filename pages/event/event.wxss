.page-container {
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 活动分类 */
.event-tabs {
  display: flex;
  background: white;
  padding: 20rpx 20rpx 0;
  margin-bottom: 4rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #888;
  border-bottom: 4rpx solid transparent;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: #667eea;
  border-bottom-color: #667eea;
  font-weight: 600;
}

/* 活动卡片 */
.event-list {
  padding: 20rpx;
}

.event-card {
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.3s ease;
}

.event-card:active {
  transform: scale(0.98);
}

.event-cover {
  width: 100%;
  height: 320rpx;
  background: #f0f0f0;
}

.event-info {
  padding: 28rpx;
}

.event-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.event-meta {
  margin-bottom: 16rpx;
}

.meta-item {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.event-status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.event-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.event-status {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.status-upcoming {
  background: linear-gradient(135deg, #e8f0fe, #dce8fb);
  color: #667eea;
}

.status-ended {
  background: #f5f5f5;
  color: #bbb;
}

.event-participants {
  display: flex;
  align-items: center;
}

.participant-avatars {
  display: flex;
  margin-right: 12rpx;
}

.participant-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid white;
  margin-left: -8rpx;
}

.participant-avatar:first-child {
  margin-left: 0;
}

.participant-count {
  font-size: 22rpx;
  color: #bbb;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.empty-subtext {
  font-size: 26rpx;
  color: #ddd;
}
