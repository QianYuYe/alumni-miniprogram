.page-container {
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 快捷发布 */
.quick-post {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
  margin: 24rpx 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(102, 126, 234, 0.25);
}

.user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 3rpx solid rgba(255,255,255,0.5);
}

.post-placeholder {
  flex: 1;
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  margin: 0 20rpx;
  background: rgba(255,255,255,0.15);
  padding: 18rpx 28rpx;
  border-radius: 36rpx;
  backdrop-filter: blur(10rpx);
}

.post-btn {
  background: rgba(255,255,255,0.25);
  color: white;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
  font-weight: 600;
  backdrop-filter: blur(10rpx);
}

/* 分类标签 */
.filter-tabs {
  display: flex;
  white-space: nowrap;
  padding: 0 20rpx 10rpx;
  margin-bottom: 10rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  background: #f0f2f5;
  padding-top: 10rpx;
}

.tab-item {
  display: inline-flex;
  padding: 14rpx 32rpx;
  margin-right: 16rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #888;
  background: white;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: all 0.3s ease;
}

.tab-item:active {
  transform: scale(0.95);
}

.tab-item.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

/* 动态列表 */
.moment-list {
  padding-bottom: 20rpx;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.load-more .loading-dot {
  width: 12rpx;
  height: 12rpx;
  margin: 0 6rpx;
  background: #667eea;
  border-radius: 50%;
  animation: loading-bounce 1.4s ease-in-out infinite;
}

.load-more .loading-dot:nth-child(1) { animation-delay: 0s; }
.load-more .loading-dot:nth-child(2) { animation-delay: 0.16s; }
.load-more .loading-dot:nth-child(3) { animation-delay: 0.32s; }

.load-text {
  font-size: 24rpx;
  color: #bbb;
  margin-left: 16rpx;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 50rpx 0;
  color: #ddd;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.empty-subtext {
  font-size: 26rpx;
  color: #ccc;
}
