<view class="page-container">
  <!-- 顶部快捷发布入口 -->
  <view class="quick-post" bindtap="goToPublish">
    <image class="user-avatar" src="{{userInfo.avatar || 'https://picsum.photos/seed/default/200/200'}}" mode="aspectFill" />
    <text class="post-placeholder">分享校友生活...</text>
    <view class="post-btn">发布</view>
  </view>

  <!-- 动态分类筛选 -->
  <scroll-view class="filter-tabs" scroll-x enable-flex>
    <view class="tab-item {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">
      <text>全部</text>
    </view>
    <view class="tab-item {{currentTab === 'hot' ? 'active' : ''}}" bindtap="switchTab" data-tab="hot">
      <text>热门</text>
    </view>
    <view class="tab-item {{currentTab === 'activity' ? 'active' : ''}}" bindtap="switchTab" data-tab="activity">
      <text>校友活动</text>
    </view>
    <view class="tab-item {{currentTab === 'help' ? 'active' : ''}}" bindtap="switchTab" data-tab="help">
      <text>求助咨询</text>
    </view>
  </scroll-view>

  <!-- 动态列表 -->
  <view class="moment-list">
    <block wx:for="{{moments}}" wx:key="id">
      <post-card 
        moment="{{item}}" 
        bind:like="onLike" 
        bind:comment="onComment" 
        bind:tapcard="goToDetail"
      />
    </block>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore}}">
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
      <view class="loading-dot"></view>
      <text class="load-text">加载更多</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && moments.length > 0}}">
      <text>— 已经到底了 —</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{moments.length === 0 && !isLoading}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无动态</text>
    <text class="empty-subtext">快去发布第一条校友动态吧</text>
  </view>
</view>
